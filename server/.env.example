# RoForge server configuration (all optional for a quick start)

PORT=8787
HOST=0.0.0.0

# REQUIRED for production: a long random string (e.g. `openssl rand -hex 32`).
# Keeps session tokens valid across restarts. Without it, a random ephemeral
# secret is generated and all sessions die on restart.
# ROFORGE_SECRET=

# Where users.json is stored (default: ./data)
# ROFORGE_DATA_DIR=./data

# --- Web search -------------------------------------------------------------
# auto = use serper if SERPER_API_KEY is set, else brave if BRAVE_API_KEY is
# set, else the keyless Wikipedia fallback.
# ROFORGE_SEARCH_PROVIDER=auto
# SERPER_API_KEY=
# BRAVE_API_KEY=
# ROFORGE_SEARCH_MAX_RESULTS=6

# --- Rate limits (per user, per minute) -------------------------------------
# ROFORGE_RATE_TOOL_PER_MIN=60
# ROFORGE_RATE_REQUEST_PER_MIN=300

# --- url_fetch ---------------------------------------------------------------
# ROFORGE_FETCH_TIMEOUT_MS=15000
# ROFORGE_FETCH_MAX_BYTES=524288
